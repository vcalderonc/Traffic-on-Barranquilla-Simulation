<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
        <net-file value="barranquilla.net.xml.gz"/>
        <route-files value="corredores.rou.xml,trafico_fondo.rou.xml.gz,peatones.rou.xml.gz"/>
        <additional-files value="vtypes.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <step-length value="0.25"/>
    </time>
    <processing>
        <collision.action value="warn"/>
        <collision.check-junctions value="true"/>
        <collision.mingap-factor value="0"/>
        <time-to-teleport value="240"/>
        <ignore-route-errors value="true"/>
        <pedestrian.model value="striping"/>
    </processing>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="true"/>
    </report>
    <gui_only>
        <start value="true"/>
    </gui_only>
</configuration>
